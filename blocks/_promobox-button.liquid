{%- assign spacing_top = block.settings.spacing_top | default: 0 -%}
{%- assign spacing_top_mobile = block.settings.spacing_top_mobile | default: 0 -%}
{%- assign spacing_top_mobile_enable = block.settings.spacing_top_mobile_enable -%}
{%- assign button_1_enable = button_1_enable | default: block.settings.button_1_enable -%}
{%- assign button_1 = button_1 | default: block.settings.button_1 -%}
{%- assign button_1_url = button_1_url | default: block.settings.button_1_url | default: url | default: '/' -%}
{%- assign color_button_type_1 = color_button_type_1 | default: block.settings.color_button_type_1 -%}
{%- assign button_2_enable = button_2_enable | default: block.settings.button_2_enable -%}
{%- assign button_2 = button_2 | default: block.settings.button_2 -%}
{%- assign button_2_url = button_2_url | default: block.settings.button_2_url | default: url | default: '/' -%}
{%- assign color_button_type_2 = color_button_type_2 | default: block.settings.color_button_type_2 -%}
{%- assign block_id = 'promobox-button-' | append: block.id -%}

{%- if button_1_enable or button_2_enable -%}
    <style>
        #{{ block_id }} {
            margin-top: {{ spacing_top }}px;
        }
        {%- if spacing_top_mobile_enable -%}
        @media (max-width: 540px) {
            #{{ block_id }} {
                {%- if spacing_top_mobile_enable -%}
                margin-top: {{ spacing_top_mobile }}px;
                {%- endif -%}
            }
        }
        {%- endif -%}
    </style>
{%- endif -%}

{%- if button_1_enable -%}
    {% capture button_1_html %}
        <a href="{{ button_1_url }}" class="promobox__btn-1 btn btn--{{ color_button_type_1 | replace: '-transparent', ' btn--transparent' }}">{{ button_1 }}</a>
    {% endcapture %}
{%- endif -%}
{%- if button_2_enable -%}
    {% capture button_2_html %}
        <a href="{{ button_2_url }}" class="promobox__btn-2 btn btn--{{ color_button_type_2 | replace: '-transparent', ' btn--transparent' }}">{{ button_2 }}</a>
    {% endcapture %}
{%- endif -%}

{%- if button_1_enable and button_2_enable -%}
    <div class="promobox__btns" id="{{ block_id }}" {{ block.shopify_attributes }}>
        <div class="row no-gutters">
            <div class="col-12 col-lg-6 mb-10 mb-lg-0 pr-lg-5">
                {%- if button_1_html != blank -%}
                    {{ button_1_html }}
                {%- endif -%}
            </div>
            <div class="col-12 col-lg-6 pl-lg-5">
                {%- if button_2_html != blank -%}
                    {{ button_2_html }}
                {%- endif -%}
            </div>
        </div>
    </div>
{%- elsif button_1_enable or button_2_enable -%}
    <div id="{{ block_id }}" {{ block.shopify_attributes }}>
        {{ button_1_html | default: button_2_html }}
    </div>
{%- endif -%}

