{%- assign spacing_top = block.settings.spacing_top | default: 0 -%}
{%- assign spacing_top_mobile = block.settings.spacing_top_mobile | default: 0 -%}
{%- assign spacing_top_mobile_enable = block.settings.spacing_top_mobile_enable -%}
{%- assign color_text = block.settings.color_text -%}
{%- assign block_id = 'promobox-custom-html-' | append: block.id -%}

{%- if block.settings.page_content != blank or block.settings.liquid != blank -%}
    <style>
        {%- if color_text != blank -%}
            #{{ block_id }} * {
                color: {{ color_text }};
            }
        {%- endif -%}
        #{{ block_id }} {
            margin-top: {{ spacing_top }}px;
        }
        {%- if spacing_top_mobile_enable -%}
        @media (max-width: 540px) {
            #{{ block_id }} {
                {%- if spacing_top_mobile_enable -%}
                margin-top: {{ spacing_top_mobile }}px;
                {%- endif -%}
            }
        }
        {%- endif -%}
    </style>

    <div class="rte" id="{{ block_id }}" {{ block.shopify_attributes }}>
        {% include 'parse-page-html-content', page_content: block.settings.page_content %}
        {%- if block.settings.liquid != blank -%}
            {{ block.settings.liquid }}
        {%- endif -%}
    </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks._promobox-custom-html.name",
  "tag": null,
  "settings": [
    {
      "type": "page",
      "id": "page_content",
      "label": "t:settings.page_content"
    },
    {
      "type": "liquid",
      "id": "liquid",
      "info": "t:settings.custom_liquid_info",
      "label": "t:settings.liquid"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:settings.color_text"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "t:settings_scoped.spacing_top.top_margin__R5I__C",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "spacing_top_mobile_enable",
      "label": "t:settings_scoped.spacing_top_mobile_enable.set_mobile_top_margin__7vR5Em",
      "default": false
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "t:settings_scoped.spacing_top_mobile.mobile_top_margin__l0JpVw",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_top_mobile_enable }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks._promobox-custom-html.name"
    }
  ]
}
{% endschema %}
