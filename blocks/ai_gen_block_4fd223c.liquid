{% doc %}
  @prompt
    Build a "Telas disponibles" section on the page "Estampa tu diseño en tela." Display fabric names as small rounded pill tags in a horizontal wrapping row. Do not use the rectangular material selector style from the product pages.
    Section label (small uppercase text above the pills):
    Telas disponibles
    Pill style:
    Rounded corners, light border, no fill, small text. Similar to a tag or badge style.
    Pills (hardcoded, one per fabric):
    Asahi · Barcelona Deco · Campania · Canoa Eco · Charlie Flow · Kiwi · Leblon · Microfibra · Nautical · Twin Velvet, ability to add more names if needed, or remove 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fabric-pills-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-fabric-pills__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ block.settings.label_color }};
    margin-bottom: {{ block.settings.label_spacing }}px;
    display: block;
  }

  .ai-fabric-pills__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.pill_gap }}px;
  }

  .ai-fabric-pills__pill-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    border: {{ block.settings.pill_border_width }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    background-color: {{ block.settings.pill_background_color }};
    color: {{ block.settings.pill_text_color }};
    font-size: {{ block.settings.pill_font_size }}px;
    line-height: 1.4;
    transition: all 0.2s ease;
  }

  .ai-fabric-pills__pill-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pill_hover_background_color }};
    border-color: {{ block.settings.pill_hover_border_color }};
    color: {{ block.settings.pill_hover_text_color }};
  }
{% endstyle %}

<div class="ai-fabric-pills-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_label != blank %}
    <span class="ai-fabric-pills__label-{{ ai_gen_id }}">{{ block.settings.section_label }}</span>
  {% endif %}
  
  <div class="ai-fabric-pills__container-{{ ai_gen_id }}">
    {% for i in (1..20) %}
      {% assign fabric_key = 'fabric_' | append: i %}
      {% assign fabric_name = block.settings[fabric_key] %}
      {% if fabric_name != blank %}
        <span class="ai-fabric-pills__pill-{{ ai_gen_id }}">{{ fabric_name }}</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

