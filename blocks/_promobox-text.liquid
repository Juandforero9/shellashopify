{%- assign text_line = block.settings.text_line -%}
{%- assign size_class = block.settings.size_class | default: 0 -%}
{%- assign size_class_mobile = block.settings.size_class_mobile | default: 0 -%}
{%- assign size_class_mobile_enable = block.settings.size_class_mobile_enable -%}
{%- assign spacing_top = block.settings.spacing_top | default: 0 -%}
{%- assign spacing_top_mobile = block.settings.spacing_top_mobile | default: 0 -%}
{%- assign spacing_top_mobile_enable = block.settings.spacing_top_mobile_enable -%}
{%- assign extra_classes = block.settings.extra_classes -%}
{%- assign text_uppercase = block.settings.text_uppercase -%}
{%- assign position_relative = block.settings.position_relative -%}
{%- assign underline_style = block.settings.underline_style | default: 'none' -%}
{%- assign link_url = block.settings.link_url -%}
{%- assign color_text = block.settings.color_text -%}
{%- assign block_id = 'promobox-text-' | append: block.id -%}

{%- assign link_tag = 'div' -%}
{%- if link_url != blank -%}
    {%- assign link_tag = 'a' -%}
{%- endif -%}

{%- case underline_style -%}
    {%- when 'underline' -%}
        {%- assign underline_classes = 'text-underline' -%}
    {%- when 'underline-hover' -%}
        {%- assign underline_classes = 'text-underline-hover' -%}
    {%- when 'underline-hover-disable' -%}
        {%- assign underline_classes = 'text-underline text-underline-hover-disable' -%}
{%- endcase -%}

{%- if text_line != blank -%}
    <style>
        #{{ block_id }} {
            margin-top: {{ spacing_top }}px;
            {%- if color_text != blank -%}
                color: {{ color_text }};
            {%- endif -%}
        }
        {%- if spacing_top_mobile_enable -%}
        @media (max-width: 540px) {
            #{{ block_id }} {
                {%- if spacing_top_mobile_enable -%}
                margin-top: {{ spacing_top_mobile }}px;
                {%- endif -%}
            }
        }
        {%- endif -%}
    </style>
    <{{ link_tag }}{% if link_url != blank %} href="{{ link_url }}"{% endif %} class="d-block" {{ block.shopify_attributes }}>
        <p id="{{ block_id }}" class="promobox__text {{ size_class }}{% if size_class_mobile_enable %} {{ size_class_mobile }}{% endif %}{% if text_uppercase %} text-uppercase{% endif %} {{ underline_classes }}{% if extra_classes != blank %} {{ extra_classes }}{% endif %}">{{ text_line }}</p>
    </{{ link_tag }}>
{%- endif -%}

