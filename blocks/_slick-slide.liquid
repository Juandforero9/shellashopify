{% include 'global-variables' %}

{%- assign slider_height = section.settings.height -%}
{%- assign slider_min_height = section.settings.min_height -%}

{% capture content_for_blocks %}
    {% content_for 'blocks' %}
{% endcapture %}

{% if block.settings.url != blank %}
    <a href="{{ block.settings.url }}" data-target="_blank" class="slider__slide" {{ block.shopify_attributes }} id="{{ block.id }}"
        {% if block.settings.delay > 0 %}data-delay="{{ block.settings.delay | times: 1000 }}"{% endif %}>
        {% include 'block-promobox', content_for_blocks: content_for_blocks, video_lazyload: false, promobox_curtain_opacity: promobox_curtain_opacity, promobox_height_preset_1: promobox_height_preset_1, promobox_height_preset_2: promobox_height_preset_2, promobox_height_preset_3: promobox_height_preset_3, promobox_ultra_height_preset_1: promobox_ultra_height_preset_1, promobox_ultra_height_preset_3: promobox_ultra_height_preset_3, height: slider_height, min_height: slider_min_height, is_slider: true, banner_type: 'media-with-text' %}
    </a>
{% else %}
    <div class="slider__slide" {{ block.shopify_attributes }} id="{{ block.id }}"
        {% if block.settings.delay > 0 %}data-delay="{{ block.settings.delay | times: 1000 }}"{% endif %}>
        {% include 'block-promobox', content_for_blocks: content_for_blocks, video_lazyload: false, promobox_curtain_opacity: promobox_curtain_opacity, promobox_height_preset_1: promobox_height_preset_1, promobox_height_preset_2: promobox_height_preset_2, promobox_height_preset_3: promobox_height_preset_3, promobox_ultra_height_preset_1: promobox_ultra_height_preset_1, promobox_ultra_height_preset_3: promobox_ultra_height_preset_3, height: slider_height, min_height: slider_min_height, is_slider: true, banner_type: 'media-with-text' %}
    </div>
{% endif %}
{%- assign slider_index = slider_index | plus: 1 -%}

