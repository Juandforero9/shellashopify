{% doc %}
  @prompt
    Regenerate a hero section for a Shella theme landing page with a full-width background image support and a dark overlay for text readability. The section must have a schema setting for uploading a background image. Match the site's existing button styles, fonts, colors, and spacing. Include:
    - Eyebrow text: "Tela personalizada · Sutex Colombia"
    - Heading: "Imprime tu diseño en tela"
    - Body text: "Sube tu archivo, elige tu sustrato y recibe tu pedido en tu taller. Desde 1 metro, con producción y envío desde Cota, Cundinamarca."
    - Primary button: "Subir mi diseño →" linking to #
    - A schema image_picker setting called "background_image" so the merchant can upload their own textile photo
    - A schema range setting for overlay opacity (0–100, default 50) with a dark overlay color (#000000)
    - Text should be white when a background image is present
    - Minimum section height of 500px on desktop, overlay color picker, text colors? button colors? , heading text is not that color it's a different color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 800px;
    max-height: 500px;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    max-width: 800px;
    padding: 40px 20px;
    text-align: center;
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    font-weight: 500;
    color: {{ block.settings.eyebrow_color }};
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 24px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
  }

  .ai-hero-body-{{ ai_gen_id }} {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    color: {{ block.settings.body_color }};
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 30px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }} !important;
    border: 2px solid {{ block.settings.button_border_color }};
  }

  .ai-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    color: {{ block.settings.button_hover_text_color }} !important;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-section-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-hero-body-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }
  }
{% endstyle %}

<div
  class="ai-hero-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-content-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-hero-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-hero-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-hero-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom design hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Tela personalizada · Sutex Colombia"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Imprime tu diseño en tela"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Sube tu archivo, elige tu sustrato y recibe tu pedido en tu taller. Desde 1 metro, con producción y envío desde Cota, Cundinamarca."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subir mi diseño →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Custom design hero"
    }
  ]
}
{% endschema %}
