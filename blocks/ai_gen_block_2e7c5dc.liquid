{% doc %}
  @prompt
    Build a landing page for "Imprime tu diseño en tela" (handle: imprime-tu-diseno-en-tela) using Shella-native section types where possible. Match the site's existing button styles, fonts, colors, and spacing. Build these sections in order:
    
    1. Hero section
    - Eyebrow text: "Tela personalizada · Sutex Colombia"
    - Heading: "Imprime tu diseño en tela"
    - Body text: "Sube tu archivo, elige tu sustrato y recibe tu pedido en tu taller. Desde 1 metro, con producción y envío desde Cota, Cundinamarca."
    - Primary button: "Subir mi diseño →" linking to #
    
    2. Icon + text columns (3 columns)
    - Column 1: Icon + "Sin mínimos imposibles" / "Arranca tu producción desde 1 metro. Sin inventario comprometido."
    - Column 2: Icon + "Tu archivo, tu marca" / "Imprimimos exactamente lo que diseñas. Colores fieles, bordes precisos."
    - Column 3: Icon + "Hecho en Colombia" / "Producción en planta propia y envío por Servientrega a todo el país."
    
    3. Numbered steps / how it works section
    - Section heading: "Cómo funciona"
    - Step 1: "Sube tu diseño" — "Ingresa tu información, elige el sustrato y adjunta tu archivo en PNG, PDF o AI en alta resolución."
    - Step 2: "Confirmamos tu pedido" — "Nuestro equipo revisa el archivo y te confirma disponibilidad y precio en menos de 24 horas."
    - Step 3: "Producimos y enviamos" — "Impresión en planta y despacho por Servientrega con número de guía incluido."
    
    4. Closing CTA banner
    - Heading: "¿Tienes un diseño listo?"
    - Subtext: "Completa el formulario y nos ponemos en contacto."
    - Button: "Subir mi diseño →" linking to #
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cta-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-cta-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 40px 20px;
    text-align: {{ block.settings.text_alignment }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-cta-banner-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-cta-banner-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 25px;
    line-height: 1.6;
  }

  .ai-cta-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }} !important;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .ai-cta-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-cta-banner-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-cta-banner-subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-cta-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cta-banner-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-cta-banner-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-cta-banner-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </p>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-cta-banner-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

