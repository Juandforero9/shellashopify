<div data-section-id="{{ section.id }}" data-section-type="spacer"{% render 'layout-get-container-class' %}>
    {%- if section.settings.margin_top_mobile != 0 -%}
        {%- assign margin_top_mobile = section.settings.margin_top_mobile -%}
    {%- else -%}
        {%- assign margin_top_mobile = section.settings.margin_top -%}
    {%- endif -%}
    {%- if section.settings.margin_bottom_mobile != 0 -%}
        {%- assign margin_bottom_mobile = section.settings.margin_bottom_mobile -%}
    {%- else -%}
        {%- assign margin_bottom_mobile = section.settings.margin_bottom -%}
    {%- endif -%}
    {% capture section_margins %}pt-{{ margin_top_mobile }} pt-md-{{ section.settings.margin_top }} pb-{{ margin_bottom_mobile }} pb-md-{{ section.settings.margin_bottom }}{% endcapture %}
    <div class="builder-spacer {{ section_margins }}">
        {%- if section.settings.show_separator -%}
            <div class="border-top"></div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
            <h2 class="h4 home-section-title{% if section.settings.show_separator %} mt-30{% endif %} mb-0 text-center">{{ section.settings.title | remove: '<p>' | remove: '</p>' | remove: ' class="text-underline"' | replace: '&lt;', '<' | replace: '&gt;', '>' }}</h2>
        {%- endif -%}
    </div>
</div>


{% schema %}
{
  "name": "t:names.spacer",
  "settings": [
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:settings.margin_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:settings.margin_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:settings.margin_top_mobile",
      "info": "t:settings.margin_top_mobile_info",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:settings.margin_bottom_mobile",
      "info": "t:settings.margin_top_mobile_info",
      "default": 0
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:settings.container",
      "default": "boxed",
      "options": [
        {
          "value": "fullwidth",
          "label": "t:options.fullwidth"
        },
        {
          "value": "boxed",
          "label": "t:options.boxed"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "t:settings.show_separator",
      "default": false
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "t:settings.title"
    },
    {
      "type": "header",
      "content": "t:content.user_manual__J_Pw01"
    },
    {
      "type": "paragraph",
      "content": "t:content.read_user_manualhttpsmpithemesgitbookios__cr6a29"
    }
  ],
  "presets": [
    {
      "name": "t:names.spacer",
      "category": "t:categories.1_main_building_sections"
    }
  ]
}
{% endschema %}