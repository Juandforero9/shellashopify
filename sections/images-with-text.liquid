{% include 'global-variables' %}

{%- liquid
  assign options = section.settings

  assign content_layout = options.content_layout
  assign image_layout = options.image_layout
  assign img_ratio = options.img_ratio | default: 1
  assign rotate_images = options.rotate_images
  assign subheading = options.subheading
  assign heading = options.heading
  assign body = options.body
  assign content_alignment = options.content_alignment
  assign heading_size = options.heading_size
  assign body_size = options.body_size

  assign first_button_text = options.first_button_text
  assign first_button_link = options.first_button_link
  assign first_button_style = options.first_button_style

  assign second_button_text = options.second_button_text
  assign second_button_link = options.second_button_link
  assign second_button_style = options.second_button_style

  assign background_color = options.background_color
  assign text_color = options.text_color
  assign subheading_color = options.subheading_color
  assign link_color = options.link_color

  assign image_count = section.blocks.size
  if image_count > 4
    assign image_count = 4
  endif

  assign container_type = 'boxed'
  if options.container_size == 'fullwidth' or options.container_size == 'page-width'
    assign container_type = 'boxed'
  endif

  assign padding_top = 0
  assign padding_bottom = 24
  case options.section_spacing_top
    when 's'
      assign padding_top = 24
    when 'm'
      assign padding_top = 32
    when 'l'
      assign padding_top = 40
    when 'xl'
      assign padding_top = 48
    when 'xxl', 'xxxl', 'xxxxl'
      assign padding_top = 64
  endcase
  case options.section_spacing_bottom
    when 's'
      assign padding_bottom = 24
    when 'm'
      assign padding_bottom = 32
    when 'l'
      assign padding_bottom = 40
    when 'xl'
      assign padding_bottom = 48
    when 'xxl', 'xxxl', 'xxxxl'
      assign padding_bottom = 64
  endcase

  case first_button_style
    when 'primary'
      assign first_btn_class = 'btn btn--default'
    when 'secondary'
      assign first_btn_class = 'btn btn--invert'
    when 'tertiary'
      assign first_btn_class = 'btn btn--secondary'
    else
      assign first_btn_class = 'btn btn--default'
  endcase

  case second_button_style
    when 'primary'
      assign second_btn_class = 'btn btn--default'
    when 'secondary'
      assign second_btn_class = 'btn btn--invert'
    when 'tertiary'
      assign second_btn_class = 'btn btn--secondary'
    else
      assign second_btn_class = 'btn btn--invert'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .images-with-text {
    background-color: {{ background_color }};
    color: {{ text_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .images-with-text__subheading {
    color: {{ subheading_color }};
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .images-with-text__heading--display1 {
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .images-with-text__heading--display2 {
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .images-with-text__heading--h1,
  #shopify-section-{{ section.id }} .images-with-text__heading--h2,
  #shopify-section-{{ section.id }} .images-with-text__heading--h3 {
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .images-with-text__heading {
    color: {{ text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .images-with-text__text {
    color: {{ text_color }};
    margin: 0 0 24px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .images-with-text__text--body3 {
    font-size: 16px;
  }

  #shopify-section-{{ section.id }} .images-with-text__text--body2 {
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .images-with-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .images-with-text__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: {{ link_color }};
    font-weight: 600;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid {
    display: flex;
    flex-direction: column-reverse;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .images-with-text__content {
    display: flex;
    flex-direction: column;
    text-align: {{ content_alignment }};
    align-items: {% if content_alignment == 'center' %}center{% elsif content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .images-with-text__media {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage-shape {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage-shape::before {
    content: '';
    display: block;
    padding-bottom: {{ img_ratio | times: 100 }}%;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage-item {
    position: absolute;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage-item-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-bottom: {{ img_ratio | times: 100 }}%;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage-item-media img,
  #shopify-section-{{ section.id }} .images-with-text__collage-item-media video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(1) {
    bottom: 7.75%;
    left: 0;
    width: 50.5%;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(2) {
    top: 8.75%;
    right: 0;
    width: 64.5%;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(3) {
    right: 3.5%;
    bottom: 0;
    width: 33%;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(4) {
    top: 0;
    left: 14%;
    width: 33.25%;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(1) {
    top: 0;
    left: 0;
    width: 51%;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(2) {
    top: 18%;
    right: 0;
    width: 64.25%;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(3) {
    bottom: 0;
    left: 13%;
    width: 39.5%;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--2 .images-with-text__collage-item:nth-child(1) {
    top: 0;
    left: 0;
    width: 63%;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--2 .images-with-text__collage-item:nth-child(2) {
    right: 0;
    bottom: 0;
    width: 63%;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--1 .images-with-text__collage-item:nth-child(1) {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .images-with-text__collage--1 .images-with-text__collage-item-media {
    position: absolute;
    inset: 0;
    padding-bottom: 0;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--4 {
    grid-template-columns: repeat(2, 1fr);
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--3 {
    grid-template-columns: repeat(2, 1fr);
    grid-template-areas:
      "first first"
      "second third";
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--3 .images-with-text__grid-item:nth-child(1) {
    grid-area: first;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--3 .images-with-text__grid-item:nth-child(2) {
    grid-area: second;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--3 .images-with-text__grid-item:nth-child(3) {
    grid-area: third;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-layout--1 {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ img_ratio }};
  }

  #shopify-section-{{ section.id }} .images-with-text__grid-item img,
  #shopify-section-{{ section.id }} .images-with-text__grid-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  {% if rotate_images %}
    #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(1) { transform: rotate(-5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(2) { transform: rotate(5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(3) { transform: rotate(15deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--4 .images-with-text__collage-item:nth-child(4) { transform: rotate(-5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(1) { transform: rotate(-5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(2) { transform: rotate(5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--3 .images-with-text__collage-item:nth-child(3) { transform: rotate(15deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--2 .images-with-text__collage-item:nth-child(1) { transform: rotate(-5deg); }
    #shopify-section-{{ section.id }} .images-with-text__collage--2 .images-with-text__collage-item:nth-child(2) { transform: rotate(5deg); }
  {% endif %}

  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .images-with-text__grid {
      flex-direction: {% if content_layout == 'right' %}row-reverse{% else %}row{% endif %};
      align-items: center;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .images-with-text__content,
    #shopify-section-{{ section.id }} .images-with-text__media {
      flex: 1 1 50%;
      max-width: 50%;
    }
  }
{% endstyle %}

<section class="images-with-text">
  <div{% render 'layout-get-container-class', container: container_type, fullwidth_need_paddings: true %}>
    <div class="images-with-text__grid">
      <div class="images-with-text__content">
        {%- if subheading != blank -%}
          <p class="images-with-text__subheading">{{ subheading }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="images-with-text__heading images-with-text__heading--{{ heading_size }}">{{ heading }}</h2>
        {%- endif -%}

        {%- if body != blank -%}
          <div class="images-with-text__text rte images-with-text__text--{{ body_size }}">{{ body }}</div>
        {%- endif -%}

        {%- if first_button_text != blank or second_button_text != blank -%}
          <div class="images-with-text__buttons">
            {%- if first_button_text != blank -%}
              {%- if first_button_style == 'link' -%}
                <a href="{{ first_button_link | default: '#' }}" class="images-with-text__link">
                  {{ first_button_text }}
                  <span aria-hidden="true">→</span>
                </a>
              {%- else -%}
                <a href="{{ first_button_link | default: '#' }}" class="{{ first_btn_class }}">{{ first_button_text }}</a>
              {%- endif -%}
            {%- endif -%}

            {%- if second_button_text != blank -%}
              {%- if second_button_style == 'link' -%}
                <a href="{{ second_button_link | default: '#' }}" class="images-with-text__link">
                  {{ second_button_text }}
                  <span aria-hidden="true">→</span>
                </a>
              {%- else -%}
                <a href="{{ second_button_link | default: '#' }}" class="{{ second_btn_class }}">{{ second_button_text }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="images-with-text__media">
        {%- if image_layout == 'collage' -%}
          <div class="images-with-text__collage-shape">
            <div class="images-with-text__collage images-with-text__collage--{{ image_count }}">
              {%- for block in section.blocks limit: 4 -%}
                {%- liquid
                  assign media_type = block.settings.media_type
                  assign image = block.settings.image
                  assign video = block.settings.video
                -%}
                <div class="images-with-text__collage-item" {{ block.shopify_attributes }}>
                  <div class="images-with-text__collage-item-media">
                    {%- if media_type == 'video' and video != blank -%}
                      {{ video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'images-with-text__video' }}
                    {%- elsif image != blank -%}
                      <img
                        src="{{ image | image_url: width: 1200 }}"
                        alt="{{ image.alt | escape }}"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div class="images-with-text__grid-layout images-with-text__grid-layout--{{ image_count }}">
            {%- for block in section.blocks limit: 4 -%}
              {%- liquid
                assign media_type = block.settings.media_type
                assign image = block.settings.image
                assign video = block.settings.video
              -%}
              <div class="images-with-text__grid-item" {{ block.shopify_attributes }}>
                {%- if media_type == 'video' and video != blank -%}
                  {{ video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
                {%- elsif image != blank -%}
                  <img
                    src="{{ image | image_url: width: 900 }}"
                    alt="{{ image.alt | escape }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Images with text",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_layout",
      "label": "Content layout",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Image layout",
      "default": "collage",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "collage", "label": "Collage" }
      ]
    },
    {
      "type": "range",
      "id": "img_ratio",
      "label": "Image ratio",
      "min": 0.7,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "rotate_images",
      "label": "Rotate images",
      "default": false
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "Container width",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "large", "label": "Large" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Promo with featured images"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "display1",
      "options": [
        { "value": "display1", "label": "Display 1" },
        { "value": "display2", "label": "Display 2" },
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Share information about your brand with your customers.</p>"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "default": "body3",
      "options": [
        { "value": "body3", "label": "Medium" },
        { "value": "body2", "label": "Large" }
      ]
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "First button"
    },
    {
      "type": "text",
      "id": "first_button_text",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "first_button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "first_button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Second button"
    },
    {
      "type": "text",
      "id": "second_button_text",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "second_button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "second_button_style",
      "label": "Button style",
      "default": "link",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#001c39"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading",
      "default": "#4d85bf"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#4d85bf"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "default": "s",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Images with text",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
