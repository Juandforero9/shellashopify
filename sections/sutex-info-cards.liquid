{%- comment -%}
  Section: Sutex - Info Cards
  Reusable grid of items with optional icon, title and description.
{%- endcomment -%}

{{ 'section-info-cards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_heading = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign container_width = section.settings.container_width
  assign columns_desktop = section.settings.columns_desktop

  assign container_class = 'info-container'
  case container_width
    when 'standard'
      assign container_class = 'info-container info-container--standard'
    when 'narrow'
      assign container_class = 'info-container info-container--narrow'
    when 'full'
      assign container_class = 'info-container info-container--full'
  endcase
-%}

<section
  id="info-cards-{{ section.id }}"
  class="info-cards"
  style="background-color: {{ background_color }}; color: {{ text_color }}; padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;"
>
  <div class="{{ container_class }}">
    {%- if section_heading != blank -%}
      <h2 class="info-title info-title--{{ heading_alignment }}">{{ section_heading }}</h2>
    {%- endif -%}

    <div class="info-grid info-grid--cols-{{ columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'item' -%}
            {%- assign item_title = block.settings.title | default: '' -%}
            {%- assign item_text = block.settings.text | default: '' -%}
            <article class="info-item" {{ block.shopify_attributes }}>
              <div class="info-icon">
                {%- if block.settings.icon != blank -%}
                  <img
                    src="{{ block.settings.icon | image_url: width: 160 }}"
                    alt="{{ item_title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {%- else -%}
                  <svg width="64" height="64" viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="info-icon--fallback">
                    <path fill="currentColor" d="M3 6h18v12H3zM5 8v8h14V8z"/>
                  </svg>
                {%- endif -%}
              </div>
              {%- if item_title != blank -%}
                <h3 class="info-item-title">{{ item_title }}</h3>
              {%- endif -%}
              {%- if item_text != blank -%}
                <p class="info-item-text">{{ item_text }}</p>
              {%- endif -%}
            </article>
          {%- when 'logos' -%}
            <article class="info-item info-item--logos" {{ block.shopify_attributes }}>
              <div class="logos-grid">
                {%- for i in (1..6) -%}
                  {%- assign key = 'logo_' | append: i -%}
                  {%- assign img = block.settings[key] -%}
                  {%- if img != blank -%}
                    <div class="logos-cell">
                      <img
                        src="{{ img | image_url: width: 420 }}"
                        alt="Logo {{ i }}"
                        width="{{ img.width }}"
                        height="{{ img.height }}"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sutex - Info Cards",
  "class": "section-sutex-info-cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Información"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0b1b2b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard container" },
        { "value": "narrow", "label": "Narrow container" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Medios de pago"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Añade aquí la descripción."
        }
      ]
    },
    {
      "type": "logos",
      "name": "Logos group (up to 6)",
      "settings": [
        { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
        { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
        { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
        { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
        { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
        { "type": "image_picker", "id": "logo_6", "label": "Logo 6" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Sutex - Info Cards",
      "category": "Sutex Sections",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Medios de pago",
            "text": "En Sutex contamos con variedad de métodos para pagar tus compras."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Tiempos de entrega",
            "text": "Promesa de entrega: 5–10 días hábiles, sujeta a ubicación y logística."
          }
        },
        {
          "type": "logos"
        }
      ]
    }
  ]
}
{% endschema %}


