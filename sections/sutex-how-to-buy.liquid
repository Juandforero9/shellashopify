{%- comment -%}
  Section: Sutex - How to Buy
  A four-step guide section with icons, titles and descriptions.
{%- endcomment -%}

{%- liquid
  assign section_heading = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign container_width = section.settings.container_width
 
  assign container_class = 'how-container'
  case container_width
    when 'standard'
      assign container_class = 'how-container how-container--standard'
    when 'narrow'
      assign container_class = 'how-container how-container--narrow'
    when 'full'
      assign container_class = 'how-container how-container--full'
  endcase
-%}
{% render '@sutex-how-to-buy' %}

<section
  id="how-to-buy-{{ section.id }}"
  class="how-to-buy"
  style="background-color: {{ background_color }}; color: {{ text_color }}; padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;"
>
  <div class="{{ container_class }}">
    {%- if section_heading != blank -%}
      <h2 class="how-title how-title--{{ heading_alignment }}">{{ section_heading }}</h2>
    {%- endif -%}

    <div class="how-steps">
      {%- for block in section.blocks -%}
        {%- assign step_title = block.settings.title | default: '' -%}
        {%- assign step_desc = block.settings.description | default: '' -%}
        <article class="how-step" {{ block.shopify_attributes }}>
          <div class="step-icon">
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 160 }}"
                alt="{{ step_title | escape }}"
                width="80"
                height="80"
                loading="lazy"
              >
            {%- else -%}
              <svg width="64" height="64" viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="step-icon--fallback">
                <path fill="currentColor" d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2Zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2ZM7.01 14h9.98c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.3.12-.48 0-.55-.45-1-1-1H6.21l-.94-2H1v2h2l3.6 7.59-1.35 2.44C4.52 16.37 5.48 18 7.01 18H19v-2H7.42c-.14 0-.25-.11-.25-.25 0-.04.01-.08.03-.11L7.01 14Z"/>
              </svg>
            {%- endif -%}
          </div>
          <h3 class="step-title">
            <span class="step-number">{{ forloop.index }}.</span>
            {{ step_title }}
          </h3>
          {%- if step_desc != blank -%}
            <p class="step-desc">{{ step_desc }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sutex - How to Buy",
  "class": "section-sutex-how-to-buy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW TO BUY"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f6f7f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0b1b2b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard container" },
        { "value": "narrow", "label": "Narrow container" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Choose your products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Pick the products you prefer."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Sutex - How to Buy",
      "category": "Sutex Sections",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Choose your products",
            "description": "Pick the products you prefer."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Shipping details",
            "description": "Fill in your information to receive your order."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Pay for your order",
            "description": "Choose your preferred payment method and confirm."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "All set!",
            "description": "Receive your products at home or at work."
          }
        }
      ]
    }
  ]
}
{% endschema %}


