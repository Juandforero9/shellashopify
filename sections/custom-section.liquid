{% include 'global-variables' %}

{%- assign spacing_class = 'section-spacing-' | append: section.id -%}
{% render 'section-spacing', section: section, spacing_class: spacing_class %}

{% capture content_html %}
    {%- assign custom_section_row_class = 'custom-section__row--' | append: section.id -%}
    {%- case section.settings.align_of_columns -%}
        {%- when 'top_left' %}{% assign align_of_columns = 'align-items-start justify-content-start' %}
        {%- when 'top_center' %}{% assign align_of_columns = 'align-items-start justify-content-center' %}
        {%- when 'top_right' %}{% assign align_of_columns = 'align-items-start justify-content-end' %}
        {%- when 'center_left' %}{% assign align_of_columns = 'align-items-center justify-content-start' %}
        {%- when 'center' %}{% assign align_of_columns = 'align-items-center justify-content-center' %}
        {%- when 'center_right' %}{% assign align_of_columns = 'align-items-center justify-content-end' %}
        {%- when 'bottom_left' %}{% assign align_of_columns = 'align-items-end justify-content-start' %}
        {%- when 'bottom_center' %}{% assign align_of_columns = 'align-items-end justify-content-center' %}
        {%- when 'bottom_right' %}{% assign align_of_columns = 'align-items-end justify-content-end' %}
        {%- when 'stretch_left' %}{% assign align_of_columns = 'align-items-stretch justify-content-start' %}
        {%- when 'stretch_center' %}{% assign align_of_columns = 'align-items-stretch justify-content-center' %}
        {%- when 'stretch_right' %}{% assign align_of_columns = 'align-items-stretch justify-content-end' %}
    {%- endcase -%}
    {%- if section.settings.precedence != blank and section.blocks.size > 0 -%}
        {%- assign precedence_arr = section.settings.precedence | replace: ' ', '' | split: ',' -%}
        <style>
            @media (max-width: 767px) {
                {%- for block in section.blocks -%}
                    {%- assign precedence_value = precedence_arr[forloop.index0] | strip -%}
                    {%- if precedence_value != blank -%}
                        .{{ custom_section_row_class }} > [id="{{ block.id }}"] {
                            order: {{ precedence_value }};
                        }
                    {%- endif -%}
                {%- endfor -%}
            }
        </style>
    {%- endif -%}
    <div class="home-builder custom-section overflow-hidden">
        {% content_for 'block', type: 'heading', id: 'heading' %}
        
        <div class="row {{ custom_section_row_class }} {{ align_of_columns }}{% if section.settings.disable_column_paddings %} no-gutters{% endif %}">
            {%- capture section_blocks -%}
                {% content_for 'blocks' %}
            {%- endcapture -%}
            {%- assign section_blocks = section_blocks | strip -%}
            {%- if section_blocks != blank -%}
                {{ section_blocks }}
            {%- else -%}
                {%- if template == 'index' -%}
                    {% render 'no-blocks' %}
                {%- endif -%}
            {%- endif -%}
        </div>
    </div>
{% endcapture %}

<div class="{{ spacing_class }}{% if section.settings.customization_class != blank %} {{ section.settings.customization_class }}{% endif %}">
    <builder-section data-section-id="{{ section.id }}" data-section-type="home-builder"{% render 'layout-get-container-class', custom_class: 'd-block' %}>
        {{ content_html }}
    </builder-section>
</div>


