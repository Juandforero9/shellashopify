{% include 'global-variables' %}
{%- assign spacing_class = 'section-spacing-' | append: section.id -%}
{% render 'section-spacing', section: section, spacing_class: spacing_class %}


{%- capture slider_blocks -%}
    {% content_for 'blocks' %}
{%- endcapture -%}
{%- assign slider_blocks = slider_blocks | strip -%}

{% capture content_html %}
    <div class="home-builder overflow-hidden">
        <div class="slider slider--2026 position-relative">
            {%- if section.settings.arrows -%}
                <div class="slider__prev d-none d-lg-block position-absolute cursor-pointer" data-js-slider-prev><i>{% render 'icon-theme-006' %}</i></div>
            {%- endif -%}
            <div class="slider__slick js-slider-tracking"
                data-js-slider-slick
                data-arrows="{{ section.settings.arrows }}"
                data-bullets="{{ section.settings.bullets }}"
                data-speed="{{ section.settings.speed }}">
                {%- if slider_blocks != blank -%}
                    {{ slider_blocks }}
                {%- else -%}
                    {%- if template == 'index' -%}
                        {% render 'no-blocks' %}
                    {%- endif -%}
                {%- endif -%}
            </div>
            {%- if section.settings.arrows -%}
                <div class="slider__next d-none d-lg-block position-absolute cursor-pointer" data-js-slider-next><i>{% render 'icon-theme-007' %}</i></div>
            {%- endif -%}
        </div>
    </div>
{% endcapture %}
<div class="{{ spacing_class }}{% if section.settings.customization_class != blank %} {{ section.settings.customization_class }}{% endif %}">
    <builder-section data-section-id="{{ section.id }}" data-section-type="slideshow"{% render 'layout-get-container-class', custom_class: 'd-block' %}>
        {{ content_html }}
    </builder-section>
</div>

<script>
    theme.AssetsLoader.require('scripts', 'builder');
</script>


